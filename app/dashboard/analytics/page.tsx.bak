"use client";

import { useEffect, useState } from "react";
import { useRestaurant } from "@/hooks/useRestaurant";
import { useAnalytics } from "@/hooks/useAnalytics";
import {
  MetricCard,
  SimpleBarChart,
  SimpleLineChart,
  DoughnutChart,
  SalesHeatmapChart,
  CategoryPerformanceChart,
  AOVTrendsChart,
  RepeatPurchaseCohortsChart,
  TopLostOpportunitiesChart,
} from "@/components/analytics/ChartComponents";
import { TrendingUp, Users, ShoppingCart, DollarSign } from "lucide-react";

export default function AnalyticsPage() {
  const { restaurants, fetchRestaurants } = useRestaurant();
  const {
    data: analyticsData,
    fetchComprehensiveAnalytics,
    loading,
    error: analyticsError,
    salesHeatmap,
    heatmapLoading,
    heatmapError,
    fetchSalesHeatmap,
    categoryPerformance,
    categoryLoading,
    categoryError,
    fetchCategoryPerformance,
    aovTrends,
    aovLoading,
    aovError,
    fetchAOVTrends,
    repeatCohorts,
    cohortLoading,
    cohortError,
    fetchRepeatPurchaseCohorts,
    lostOpportunities,
    opportunitiesLoading,
    opportunitiesError,
    fetchLostOpportunities,
  } = useAnalytics();
  const [selectedRestaurantId, setSelectedRestaurantId] = useState<
    string | null
  >(null);
  const [pageLoading, setPageLoading] = useState(true);

  useEffect(() => {
    const loadData = async () => {
      try {
        await fetchRestaurants();
      } catch (error) {
        console.error("Failed to load restaurants:", error);
      } finally {
        setPageLoading(false);
      }
    };
    loadData();
  }, [fetchRestaurants]);

  // Auto-select first restaurant and load analytics
  useEffect(() => {
    const hasRestaurants = Array.isArray(restaurants) && restaurants.length > 0;
    if (hasRestaurants && !selectedRestaurantId) {
      const restaurantId = restaurants[0]._id;
      setSelectedRestaurantId(restaurantId);
      fetchComprehensiveAnalytics(restaurantId);
      fetchSalesHeatmap(restaurantId, 30, "UTC");
      if (typeof fetchAOVTrends === "function") {
        fetchAOVTrends(restaurantId, 30, "UTC");
      }
      fetchCategoryPerformance(restaurantId, 30);
      fetchRepeatPurchaseCohorts(restaurantId, 30, "UTC");
      fetchLostOpportunities && typeof fetchLostOpportunities === "function" && fetchLostOpportunities(restaurantId, 30);
    }
  }, [
    restaurants,
    selectedRestaurantId,
    fetchComprehensiveAnalytics,
    fetchSalesHeatmap,
    fetchAOVTrends,
    fetchCategoryPerformance,
    fetchRepeatPurchaseCohorts,
    fetchLostOpportunities,
  ]);

  // Handle restaurant selection
  const handleRestaurantChange = (restaurantId: string) => {
    setSelectedRestaurantId(restaurantId);
    fetchComprehensiveAnalytics(restaurantId);
    fetchSalesHeatmap(restaurantId, 30, "UTC");
    if (typeof fetchAOVTrends === "function") {
      fetchAOVTrends(restaurantId, 30, "UTC");
    }
    fetchCategoryPerformance(restaurantId, 30);
    fetchRepeatPurchaseCohorts(restaurantId, 30, "UTC");
    fetchLostOpportunities && typeof fetchLostOpportunities === "function" && fetchLostOpportunities(restaurantId, 30);
  };

  if (pageLoading) {
    return (
      <div className="flex items-center justify-center h-96">
        <div className="text-center">
          <div className="animate-spin text-4xl mb-4">⚙️</div>
          <p className="text-slate-400">Loading analytics...</p>
        </div>
      </div>
    );
  }

  if (restaurants.length === 0) {
    return (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl hero-title font-bold text-slate-100">
            Analytics
          </h2>
          <p className="text-slate-400 mt-1">
            Track your restaurant performance
          </p>
        </div>
        <div className="card text-center py-12">
          <p className="text-slate-400">
            No restaurants found. Create one to see analytics.
          </p>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-8">
      {/* Header */}
      <div>
        <h2 className="text-3xl hero-title font-bold text-slate-100">
          Analytics Dashboard
        </h2>
        <p className="text-slate-400 mt-1">
          Comprehensive performance metrics for{" "}
          {analyticsData?.period?.month || "your restaurant"}
        </p>
      </div>

      {/* Restaurant Selector */}
      <div className="flex gap-2 flex-wrap">
        {restaurants.map(restaurant => (
          <button
            key={restaurant._id}
            onClick={() => handleRestaurantChange(restaurant._id)}
            className={`px-4 py-2 rounded-lg transition-all ${
              selectedRestaurantId === restaurant._id
                ? "bg-cyan-500/30 text-cyan-300 border border-cyan-500"
                : "bg-slate-700/30 text-slate-300 border border-slate-600 hover:border-slate-500"
            }`}
          >
            {restaurant.name}
          </button>
        ))}
      </div>

      {analyticsError && (
        <div className="card border border-red-500/40 bg-red-500/10">
          <p className="text-red-300 font-semibold">Unable to load analytics</p>
          <p className="text-red-200/90 text-sm mt-1">{analyticsError}</p>
        </div>
      )}

      {heatmapError && (
        <div className="card border border-amber-500/40 bg-amber-500/10">
          <p className="text-amber-300 font-semibold">
            Sales heatmap temporarily unavailable
          </p>
          <p className="text-amber-200/90 text-sm mt-1">{heatmapError}</p>
        </div>
      )}

      {categoryError && (
        <div className="card border border-amber-500/40 bg-amber-500/10">
          <p className="text-amber-300 font-semibold">
            Category performance temporarily unavailable
          </p>
          <p className="text-amber-200/90 text-sm mt-1">{categoryError}</p>
        </div>
      )}

      {loading ? (
        <div className="card text-center py-12">
          <div className="inline-block animate-spin text-3xl mb-4">⚙️</div>
          <p className="text-slate-400">Loading analytics...</p>
        </div>
      ) : analyticsData ? (
        <>
          {/* Key Metrics - Row 1 */}
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <MetricCard
              title="Total QR Scans"
              value={analyticsData.summary.totalQRScans}
              subtitle={`${analyticsData.period.month} ${analyticsData.period.year}`}
              icon="📱"
              color="cyan"
            />
            <MetricCard
              title="Total Dishes Visited"
              value={analyticsData.summary.totalDishesVisited}
              subtitle="Unique menu items viewed"
              icon="👁️"
              color="purple"
            />
            <MetricCard
              title="3D Model Views"
              value={analyticsData.summary.total3DModelViews}
              subtitle="AR engagement"
              icon="🎥"
              color="blue"
            />
            <MetricCard
              title="Total Orders"
              value={analyticsData.summary.totalOrders}
              subtitle="Completed orders"
              icon="🛒"
              color="green"
            />
          </div>

          {/* Key Metrics - Row 2 */}
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <MetricCard
              title="Estimated Sales"
              value={`$${analyticsData.summary.estimatedSales}`}
              subtitle={`Avg: $${analyticsData.summary.avgOrderValue}`}
              icon={<DollarSign size={32} />}
              color="green"
            />
            <MetricCard
              title="Conversion Rate"
              value={`${analyticsData.customers.conversionRate.toFixed(1)}%`}
              subtitle="Scans → Orders"
              icon={<TrendingUp size={32} />}
              color="orange"
            />
            <MetricCard
              title="New Customers"
              value={analyticsData.customers.newCustomers}
              subtitle={`This month`}
              icon={<Users size={32} />}
              color="pink"
            />
            <MetricCard
              title="Repeat Customers"
              value={analyticsData.customers.repeatedCustomers}
              subtitle={`${analyticsData.customers.totalUniqueCustomers} total unique`}
              icon={<ShoppingCart size={32} />}
              color="cyan"
            />
          </div>

          {/* Most and Least Popular Dishes */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            {/* Most Popular */}
            {analyticsData.popularity.mostPopularDish && (
              <div className="card">
                <div className="flex items-center gap-2 mb-4">
                  <span className="text-2xl">🏆</span>
                  <h3 className="text-lg font-semibold text-slate-200">
                    Most Popular Dish
                  </h3>
                </div>
                <div className="space-y-3">
                  <div>
                    <p className="text-3xl font-bold text-yellow-400">
                      {analyticsData.popularity.mostPopularDish.name}
                    </p>
                  </div>
                  <div className="flex items-baseline gap-2">
                    <p className="text-5xl font-bold text-yellow-300">
                      {analyticsData.popularity.mostPopularDish.orders}
                    </p>
                    <p className="text-slate-400">orders this month</p>
                  </div>
                  <div className="pt-4 border-t border-slate-700">
                    <p className="text-sm text-slate-400 mb-3">
                      Top 5 ordered dishes
                    </p>
                    {analyticsData.popularity.topDishes.map((dish, idx) => (
                      <div
                        key={idx}
                        className="flex justify-between items-center py-2"
                      >
                        <span className="text-slate-300">
                          {idx + 1}. {dish.name}
                        </span>
                        <span className="text-cyan-400 font-semibold">
                          {dish.orders}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {/* Least Popular */}
            {analyticsData.popularity.leastPopularDish && (
              <div className="card">
                <div className="flex items-center gap-2 mb-4">
                  <span className="text-2xl">📉</span>
                  <h3 className="text-lg font-semibold text-slate-200">
                    Least Ordered Dishes
                  </h3>
                </div>
                <div className="space-y-3">
                  <div>
                    <p className="text-sm text-slate-400 mb-3">
                      Bottom 5 ordered dishes (consider removing or revamping)
                    </p>
                    {analyticsData.popularity.bottomDishes.map((dish, idx) => (
                      <div
                        key={idx}
                        className="flex justify-between items-center py-2 border-b border-slate-700/50 last:border-0"
                      >
                        <span className="text-slate-300">{dish.name}</span>
                        <span className="text-red-400 font-semibold">
                          {dish.orders}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}
          </div>

          {/* Charts Section */}
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {/* Device Breakdown */}
            <DoughnutChart
              data={[
                { label: "Web", value: analyticsData.devices.Web },
                { label: "iOS", value: analyticsData.devices.iOS },
                { label: "Android", value: analyticsData.devices.Android },
              ]}
              title="Device Breakdown"
            />

            {/* Top Items by Views */}
            <SimpleBarChart
              data={analyticsData.topItems.slice(0, 8).map(item => ({
                label: item.name.substring(0, 15),
                value: item.views,
              }))}
              title="Top Items by Views"
              color="purple"
            />
          </div>

          {/* Daily Trends */}
          {analyticsData.trends.length > 0 && (
            <SimpleLineChart
              data={analyticsData.trends.map(t => ({
                label: t._id.date,
                value: t.total,
              }))}
              title="Daily Activity Trends"
            />
          )}

          {/* Customer Metrics */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            <SimpleBarChart
              data={[
                {
                  label: "New Customers",
                  value: analyticsData.customers.newCustomers,
                },
                {
                  label: "Repeat Customers",
                  value: analyticsData.customers.repeatedCustomers,
                },
              ]}
              title="Customer Acquisition"
              color="blue"
            />

            <div className="card">
              <h3 className="text-lg font-semibold text-slate-200 mb-6">
                Performance Summary
              </h3>
              <div className="space-y-4">
                <div className="flex justify-between items-center pb-4 border-b border-slate-700">
                  <span className="text-slate-400">Avg Rating</span>
                  <span className="text-2xl font-bold text-cyan-400">
                    {analyticsData.averageRating || "N/A"}
                    {analyticsData.averageRating && "⭐"}
                  </span>
                </div>
                <div className="flex justify-between items-center pb-4 border-b border-slate-700">
                  <span className="text-slate-400">Unique Sessions</span>
                  <span className="text-2xl font-bold text-purple-400">
                    {analyticsData.customers.uniqueSessionsThisMonth}
                  </span>
                </div>
                <div className="flex justify-between items-center">
                  <span className="text-slate-400">Total Unique Customers</span>
                  <span className="text-2xl font-bold text-green-400">
                    {analyticsData.customers.totalUniqueCustomers}
                  </span>
                </div>
              </div>
            </div>
          </div>

          {/* Event Breakdown */}
          {analyticsData.trends.length > 0 && (
            <SimpleBarChart
              data={[
                {
                  label: "QR Scans",
                  value: analyticsData.trends.reduce(
                    (sum, t) => sum + t.scans,
                    0,
                  ),
                },
                {
                  label: "Menu Views",
                  value: analyticsData.trends.reduce(
                    (sum, t) => sum + t.views,
                    0,
                  ),
                },
                {
                  label: "AR Views",
                  value: analyticsData.trends.reduce(
                    (sum, t) => sum + t.arViews,
                    0,
                  ),
                },
                {
                  label: "Shares",
                  value: analyticsData.trends.reduce(
                    (sum, t) => sum + t.shares,
                    0,
                  ),
                },
              ]}
              title="Event Breakdown (This Month)"
              color="orange"
            />
          )}

          {/* Feature 2: Time-of-day and day-of-week sales heatmap */}
          {heatmapLoading ? (
            <div className="card text-center py-10">
              <p className="text-slate-400">Loading sales heatmap...</p>
            </div>
          ) : (
            salesHeatmap && (
              <SalesHeatmapChart
                title="Sales Heatmap by Day and Hour"
                data={salesHeatmap}
              />
            )
          )}

          {/* Feature 3: Category Performance */}
          {categoryLoading ? (
            <div className="card text-center py-10">
              <p className="text-slate-400">Loading category performance...</p>
            </div>
          ) : (
            categoryPerformance && (
              <>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                  <MetricCard
                    title="Category Revenue"
                    value={`$${categoryPerformance.summary.totalRevenue.toFixed(2)}`}
                    subtitle={`${categoryPerformance.summary.categoryCount} categories`}
                    icon="💰"
                    color="green"
                  />
                  <MetricCard
                    title="Category AOV"
                    value={`$${categoryPerformance.summary.averageOrderValue.toFixed(2)}`}
                    subtitle={`${categoryPerformance.summary.totalOrders} category orders`}
                    icon="🧾"
                    color="blue"
                  />
                  <MetricCard
                    title="Category Conversion"
                    value={`${categoryPerformance.summary.overallConversionRate.toFixed(2)}%`}
                    subtitle={`View source: ${categoryPerformance.meta.viewSource}`}
                    icon="🎯"
                    color="orange"
                  />
                </div>

                <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                  <CategoryPerformanceChart
                    title="Revenue vs Conversion by Category"
                    data={categoryPerformance.categories.slice(0, 8).map(item => ({
                      category: item.category,
                      revenue: item.revenue,
                      conversionRate: item.conversionRate,
                    }))}
                  />

                  <div className="card">
                    <h3 className="text-lg font-semibold text-slate-200 mb-4">
                      Category Insights
                    </h3>
                    <div className="space-y-4 text-sm">
                      <div className="p-3 rounded-lg bg-emerald-900/20 border border-emerald-700/30">
                        <p className="text-emerald-300 font-semibold">Top Revenue</p>
                        <p className="text-slate-200 mt-1">
                          {categoryPerformance.insights.topRevenueCategory?.category || "N/A"}
                        </p>
                        <p className="text-emerald-200/80 text-xs mt-1">
                          ${categoryPerformance.insights.topRevenueCategory?.revenue?.toFixed(2) || "0.00"}
                        </p>
                      </div>
                      <div className="p-3 rounded-lg bg-cyan-900/20 border border-cyan-700/30">
                        <p className="text-cyan-300 font-semibold">Best Conversion</p>
                        <p className="text-slate-200 mt-1">
                          {categoryPerformance.insights.bestConversionCategory?.category || "N/A"}
                        </p>
                        <p className="text-cyan-200/80 text-xs mt-1">
                          {categoryPerformance.insights.bestConversionCategory?.conversionRate?.toFixed(2) || "0.00"}%
                        </p>
                      </div>
                      <div className="p-3 rounded-lg bg-rose-900/20 border border-rose-700/30">
                        <p className="text-rose-300 font-semibold">Weakest Conversion</p>
                        <p className="text-slate-200 mt-1">
                          {categoryPerformance.insights.weakestCategory?.category || "N/A"}
                        </p>
                        <p className="text-rose-200/80 text-xs mt-1">
                          {categoryPerformance.insights.weakestCategory?.conversionRate?.toFixed(2) || "0.00"}%
                        </p>
                      </div>
                    </div>
                  </div>
                </div>

                <div className="card">
                  <h3 className="text-lg font-semibold text-slate-200 mb-4">
                    Category Ranking Table
                  </h3>
                  <div className="overflow-x-auto">
                    <table className="min-w-full text-sm">
                      <thead>
                        <tr className="text-left text-slate-400 border-b border-slate-700">
                          <th className="py-2 pr-3">#</th>
                          <th className="py-2 pr-3">Category</th>
                          <th className="py-2 pr-3">Revenue</th>
                          <th className="py-2 pr-3">Orders</th>
                          <th className="py-2 pr-3">AOV</th>
                          <th className="py-2 pr-3">Conversion</th>
                          <th className="py-2 pr-3">Menu Items</th>
                        </tr>
                      </thead>
                      <tbody>
                        {categoryPerformance.categories.map(row => (
                          <tr
                            key={row.category}
                            className="border-b border-slate-800 text-slate-200"
                          >
                            <td className="py-2 pr-3">{row.rank}</td>
                            <td className="py-2 pr-3">{row.category}</td>
                            <td className="py-2 pr-3">${row.revenue.toFixed(2)}</td>
                            <td className="py-2 pr-3">{row.orders}</td>
                            <td className="py-2 pr-3">${row.averageOrderValue.toFixed(2)}</td>
                            <td className="py-2 pr-3">{row.conversionRate.toFixed(2)}%</td>
                            <td className="py-2 pr-3">{row.menuItemCount}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>

                {/* Feature 4: Average Order Value Trends */}
                {aovLoading ? (
                  <div className="card text-center py-10">
                    <p className="text-slate-400">Loading AOV trends...</p>
                  </div>
                ) : aovError ? (
                  <div className="card border border-amber-500/40 bg-amber-500/10">
                    <p className="text-amber-300 font-semibold">AOV trends unavailable</p>
                    <p className="text-amber-200/90 text-sm mt-1">{aovError}</p>
                  </div>
                ) : (
                  aovTrends && <AOVTrendsChart title="Average Order Value Trends" data={aovTrends} />
                )}

                {/* Feature 5: Repeat Purchase Cohorts */}
                {cohortLoading ? (
                  <div className="card text-center py-10">
                    <p className="text-slate-400">Loading repeat cohorts...</p>
                  </div>
                ) : cohortError ? (
                  <div className="card border border-amber-500/40 bg-amber-500/10">
                    <p className="text-amber-300 font-semibold">Repeat cohorts unavailable</p>
                    <p className="text-amber-200/90 text-sm mt-1">{cohortError}</p>
                  </div>
                ) : (
                  repeatCohorts && <RepeatPurchaseCohortsChart title="Repeat Purchase Cohorts & Retention" data={repeatCohorts} />
                )}

                {/* Feature 6: Top Lost Opportunities */}
                {opportunitiesLoading ? (
                  <div className="card text-center py-10">
                    <p className="text-slate-400">Loading lost opportunities...</p>
                  </div>
                ) : opportunitiesError ? (
                  <div className="card border border-amber-500/40 bg-amber-500/10">
                    <p className="text-amber-300 font-semibold">Lost opportunities unavailable</p>
                    <p className="text-amber-200/90 text-sm mt-1">{opportunitiesError}</p>
                  </div>
                ) : (
                  lostOpportunities && <TopLostOpportunitiesChart title="Top Lost Opportunities" data={lostOpportunities} />
                )}
              </>
            )
          )}
        </>
      ) : (
        <div className="card text-center py-12">
          <p className="text-slate-400">
            No analytics data available for this restaurant.
          </p>
        </div>
      )}
    </div>
  );
}
